{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "docker-compose"
  ],
  "includePaths": [
    "apps/**"
  ],
  "labels": [
    "renovate"
  ],
  "platformAutomerge": true,
  "packageRules": [
    {
      "matchFileNames": [
        "apps/litellm/**"
      ],
      "matchPackageNames": [
        "ghcr.io/berriai/litellm"
      ],
      "groupName": "litellm-devnode",
      "addLabels": [
        "litellm",
        "ai"
      ]
    },
    {
      "matchFileNames": [
        "apps/crawl4ai/**"
      ],
      "matchPackageNames": [
        "unclecode/crawl4ai"
      ],
      "groupName": "crawl4ai",
      "addLabels": [
        "crawl4ai",
        "web-search"
      ],
      "automerge": false,
      "pinDigests": true
    },
    {
      "description": "Automerge non-major Docker updates",
      "matchUpdateTypes": [
        "patch",
        "minor",
        "pin",
        "digest"
      ],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "matchFileNames": [
        "apps/searxng/**"
      ],
      "matchPackageNames": [
        "searxng/searxng"
      ],
      "description": "SearXNG",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "searxng",
      "addLabels": [
        "searxng",
        "web-search"
      ]
    },
    {
      "matchFileNames": [
        "apps/doco-cd/**"
      ],
      "matchPackageNames": [
        "ghcr.io/kimdre/doco-cd"
      ],
      "description": "doco-cd",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "doco-cd",
      "addLabels": [
        "doco-cd",
        "gitops"
      ]
    },
    {
      "matchFileNames": [
        "apps/searxng/**"
      ],
      "matchPackageNames": [
        "valkey/valkey"
      ],
      "description": "SearXNG Valkey",
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "groupName": "searxng",
      "addLabels": [
        "searxng",
        "cache",
        "valkey"
      ]
    },
    {
      "matchFileNames": [
        "apps/crawl4ai/**",
        "apps/litellm/**"
      ],
      "automerge": false,
      "pinDigests": true
    },
    {
      "matchFileNames": [
        "apps/traefik/**"
      ],
      "matchPackageNames": [
        "traefik",
        "ghcr.io/tecnativa/docker-socket-proxy"
      ],
      "groupName": "traefik",
      "addLabels": [
        "traefik",
        "networking"
      ],
      "automerge": false,
      "pinDigests": true
    },
    {
      "matchFileNames": [
        "apps/morphic/**"
      ],
      "groupName": "morphic",
      "addLabels": [
        "morphic",
        "ai"
      ],
      "automerge": false,
      "pinDigests": true
    },
    {
      "description": "Never update archived applications",
      "matchFileNames": [
        "archive/**"
      ],
      "enabled": false
    }
  ],
  "ignorePaths": [
    "archive/**"
  ]
}
