{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "docker:pinDigests"
  ],
  "enabledManagers": [
    "docker-compose"
  ],
  "includePaths": [
    "apps/**"
  ],
  "ignorePaths": [
    "archive/**"
  ],
  "labels": [
    "renovate",
    "dependencies"
  ],
  "automerge": false,
  "packageRules": [
    {
      "description": "Keep both mutually updating Doco-CD controllers on the same image",
      "matchFileNames": [
        "apps/doco-cd/**"
      ],
      "matchPackageNames": [
        "ghcr.io/kimdre/doco-cd"
      ],
      "groupName": "doco-cd-controllers",
      "addLabels": [
        "doco-cd",
        "gitops"
      ]
    },
    {
      "matchFileNames": [
        "apps/litellm/**"
      ],
      "matchPackageNames": [
        "ghcr.io/berriai/litellm"
      ],
      "groupName": "litellm-devnode",
      "addLabels": [
        "litellm",
        "ai"
      ]
    },
    {
      "matchFileNames": [
        "apps/crawl4ai/**"
      ],
      "matchPackageNames": [
        "unclecode/crawl4ai"
      ],
      "addLabels": [
        "crawl4ai",
        "web-search"
      ]
    },
    {
      "matchFileNames": [
        "apps/morphic/**"
      ],
      "matchPackageNames": [
        "ghcr.io/miurla/morphic"
      ],
      "addLabels": [
        "morphic",
        "ai"
      ]
    },
    {
      "matchFileNames": [
        "apps/searxng/**"
      ],
      "matchPackageNames": [
        "searxng/searxng"
      ],
      "addLabels": [
        "searxng",
        "web-search"
      ]
    },
    {
      "matchFileNames": [
        "apps/traefik/**"
      ],
      "matchPackageNames": [
        "traefik",
        "ghcr.io/tecnativa/docker-socket-proxy"
      ],
      "addLabels": [
        "traefik",
        "networking"
      ]
    },
    {
      "description": "LiteLLM PostgreSQL: maintain major 16, including same-tag digest updates; major changes require separate data migration",
      "matchFileNames": [
        "apps/litellm/**"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "allowedVersions": "/^16(?:\\.\\d+)?-alpine$/",
      "addLabels": [
        "postgres",
        "database"
      ]
    },
    {
      "description": "Morphic PostgreSQL: maintain major 17, including same-tag digest updates; major changes require separate data migration",
      "matchFileNames": [
        "apps/morphic/**"
      ],
      "matchPackageNames": [
        "postgres"
      ],
      "allowedVersions": "/^17(?:\\.\\d+)?-alpine$/",
      "addLabels": [
        "postgres",
        "database"
      ]
    },
    {
      "description": "Do not propose automatic major PostgreSQL or Valkey upgrades",
      "matchPackageNames": [
        "postgres",
        "valkey/valkey"
      ],
      "matchUpdateTypes": [
        "major"
      ],
      "enabled": false
    },
    {
      "description": "Valkey data compatibility: retain major 9, allow patch and digest updates",
      "matchPackageNames": [
        "valkey/valkey"
      ],
      "allowedVersions": "/^9(?:\\.\\d+){0,2}-alpine$/",
      "addLabels": [
        "valkey",
        "cache"
      ]
    },
    {
      "description": "Never update archived applications",
      "matchFileNames": [
        "archive/**"
      ],
      "enabled": false
    }
  ]
}
